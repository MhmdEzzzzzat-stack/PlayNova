{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playnova",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [\n    {\n      "binding": "DB",\n      "database_name": "playnova-db",\n      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",\n      "migrations_dir": "migrations"\n    }\n  ],\n  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
